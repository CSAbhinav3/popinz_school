# Copy to .env and adjust for your environment

# Database - MySQL (password: if it contains @ or #, URL-encode as %40 or %23)
DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@localhost:3306/playschool

# JWT - use a strong secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# QR attendance
QR_TOKEN_EXPIRE_MINUTES=15
QR_SECRET_KEY=qr-secret-change-in-production

# App
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
